[Unit]
Description=linkding background tasks (Huey)
After=network.target

[Service]
Type=simple
User=linkding
Group=linkding
WorkingDirectory=/opt/linkding
EnvironmentFile=-/etc/default/linkding
Environment=DJANGO_SETTINGS_MODULE=bookmarks.settings.prod
ExecStart=/opt/linkding/.venv/bin/python manage.py run_huey
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
